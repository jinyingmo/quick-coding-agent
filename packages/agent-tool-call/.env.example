# Moonshot / Kimi API key (required for live REPL mode)
KIMI_API_KEY=sk-your-key-here

# Optional overrides
KIMI_MODEL=moonshot-v1-32k
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_TIMEOUT_MS=30000

# Memory directory defaults to ../../memory-system/memory from dist/cli.js.
# MEMORY_DIR=./memory

# Set DEBUG=1 to print the underlying LLM payload + tool denials.
# DEBUG=1

# MCP tool providers (JSON array, or use MCP_SERVERS_FILE)
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/abs/path"]}]
# MCP_ENABLED=true

# Skills runtime
# SKILL_ROOTS=/abs/skills/root1:/abs/skills/root2
# SKILLS=deploy-flow,qa-check
# SKILL_STRICT_ALLOWLIST=false
