# LLM API Configuration (OpenAI-compatible)
# Works with any OpenAI-compatible provider: OpenAI, Kimi, DeepSeek, Qwen, etc.

# API Key (required for --repl and HTTP server mode)
LLM_API_KEY=sk-your-key-here

# Model name — use the model ID your provider expects
# Examples:
#   gpt-4o                          (OpenAI)
#   moonshot-v1-8k                  (Kimi / Moonshot AI)
#   deepseek-chat                   (DeepSeek)
#   qwen-turbo                      (Qwen / Alibaba Cloud)
LLM_MODEL=moonshot-v1-8k

# Base URL of the OpenAI-compatible API endpoint
# Examples:
#   https://api.openai.com/v1       (OpenAI)
#   https://api.moonshot.cn/v1      (Kimi / Moonshot AI)
#   https://api.deepseek.com/v1     (DeepSeek)
#   https://dashscope.aliyuncs.com/compatible-mode/v1  (Qwen)
LLM_BASE_URL=https://api.moonshot.cn/v1

# Optional: request timeout in milliseconds (default: 30000)
# LLM_TIMEOUT_MS=30000

# P0 server auth/workspace configuration.
# Example value:
# P0_API_KEYS=[{"token":"local-dev-token","userId":"demo-user","workspaceId":"demo-workspace","cwd":"/abs/project/path","memoryDir":"/abs/project/path/packages/agent-tool-call/memory"}]
P0_API_KEYS=

# Optional HTTP port for `npm run serve`
# PORT=8787

# Optional MCP policy. MCP tools stay hidden unless both servers and allowlist are configured.
# MCP_ENABLED=false
# MCP_SERVERS=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/abs/project/path"]}]
# MCP_ALLOWED_TOOLS=mcp__filesystem__read_file
