{
  "name": "@quick-coding-agent/agent-tool-call",
  "version": "1.0.0",
  "description": "Simplified Claude-Code-style agent with tool calling and built-in persistent memory demo (Kimi/Moonshot LLM)",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "npm run build && node dist/cli.js",
    "demo": "npm run build && node dist/cli.js --scripted",
    "repl": "npm run build && node dist/cli.js --repl",
    "memory:demo": "npm run build && node dist/memoryCli.js --demo",
    "memory:demo:local": "npm run build && node dist/memoryCli.js --demo --no-llm",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "tool-calling",
    "claude-code",
    "memory",
    "kimi",
    "moonshot"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
