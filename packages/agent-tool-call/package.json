{
  "name": "@quick-coding-agent/agent-tool-call",
  "version": "1.0.0",
  "description": "Simplified Claude-Code-style agent with tool calling, integrated with the memory-system demo (Kimi/Moonshot LLM)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/cli.js",
    "demo": "npm run build && node dist/cli.js --scripted",
    "repl": "npm run build && node dist/cli.js --repl",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "tool-calling",
    "claude-code",
    "memory",
    "kimi",
    "moonshot"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "@quick-coding-agent/memory-system": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "typescript": "^5.9.3"
  }
}
