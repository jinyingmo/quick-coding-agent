{
  "name": "@quick-coding-agent/memory-system",
  "version": "1.0.0",
  "description": "Claude Code memory system core demo - file-based persistent memory with Kimi LLM integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/cli.js",
    "demo": "npm run build && node dist/cli.js --demo",
    "demo:local": "npm run build && node dist/cli.js --demo --no-llm",
    "clean": "rm -rf dist"
  },
  "keywords": ["memory", "claude", "persistence", "kimi", "llm"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
